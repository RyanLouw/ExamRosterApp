<Window x:Class="ExamRosterApp.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Exam Roster" Height="720" Width="1200">
    <Grid>
        <TabControl>
            <TabItem Header="Teachers"><DataGrid ItemsSource="{Binding Teachers}" AutoGenerateColumns="True" /></TabItem>
            <TabItem Header="Exam Slots"><DataGrid ItemsSource="{Binding Slots}" AutoGenerateColumns="True" /></TabItem>
            <TabItem Header="Roster">
                <DockPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Top">
                        <Button Content="Generate Roster" Command="{Binding GenerateRosterCommand}" Margin="4"/>
                        <Button Content="Clear Roster" Command="{Binding ClearRosterCommand}" Margin="4"/>
                    </StackPanel>
                    <TextBlock Text="{Binding WarningsText}" Foreground="DarkOrange" Margin="4" TextWrapping="Wrap" DockPanel.Dock="Bottom"/>
                    <DataGrid ItemsSource="{Binding Assignments}" AutoGenerateColumns="True"/>
                </DockPanel>
            </TabItem>
            <TabItem Header="Fairness Summary"><DataGrid ItemsSource="{Binding Fairness}" AutoGenerateColumns="True"/></TabItem>
            <TabItem Header="Migrations">
                <StackPanel Margin="12">
                    <TextBlock Text="Use this page to create/update the local development DB schema (safe local DB only)." TextWrapping="Wrap"/>
                    <Button Content="Apply EF Migrations" Command="{Binding ApplyMigrationsCommand}" Width="180" Margin="0,10,0,0"/>
                    <TextBlock Text="{Binding MigrationStatus}" Margin="0,10,0,0"/>
                </StackPanel>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
